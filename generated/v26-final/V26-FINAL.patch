+	auto* gyro_deadzone = add_gyro_setting(_("Dead Zone (degrees/s)"), original_gyro_deadzone, 0.0, 180.0, 0.1);
+	auto* calibration_period = add_gyro_setting(_("Calibration Period (s)"), original_calibration_period, 0.0, 30.0, 0.25);
